# Скопируйте в .env для локальной разработки или правьте .env.development / .env.production
#
# development: пути /api/... → src/setupProxy.js
# production:  полные https://... URL + REACT_APP_CORS_PROXY
#              (Yandex Cloud API Gateway / Cloud Function — yandex/supplier-proxy/)
#
# Авторизация (НЕ ставьте префикс REACT_APP_ — иначе логин и пароль попадут в бандл).
# prestart/prebuild считают HMAC и пишут только REACT_APP_AUTH_VERIFIER в .env.*.local
# AUTH_LOGIN=admin@admin.ru
# AUTH_PASSWORD=
# Несколько пользователей (если задано — главнее пары выше):
# AUTH_USERS=email1:password1,email2:password2

# Origin API Gateway без /v2 — фронт добавляет /v2 сам
REACT_APP_CORS_PROXY=
# 1 — добавляет &debug=1 к запросам через прокси (логи в Yandex Cloud Function)
REACT_APP_CORS_PROXY_DEBUG=

# Автосинхронизация каталога (Object Storage через тот же или другой Gateway)
# Если пусто — используется REACT_APP_CORS_PROXY. Без base URL autosync выключен.
REACT_APP_CATALOG_API_BASE=
REACT_APP_STORE_ID=ElistaIvanor
# Необязательное соответствие пользователя магазину в JSON.
# Ключом может быть SHA-256 accountId (имеет приоритет) или normalized login.
# При отсутствии совпадения используется REACT_APP_STORE_ID.
# REACT_APP_STORE_MAP={"<accountId>":"ElistaIvanor","user@example.com":"OtherStore"}

REACT_APP_SHINSERVICE_TYRES_URL=
REACT_APP_SHINSERVICE_DISCS_URL=

REACT_APP_SEMISOTNOV_TYRES_URL=
REACT_APP_SEMISOTNOV_DISCS_URL=

REACT_APP_4TOCHKI_TYRES_URL=

REACT_APP_SHINASU_URL=

REACT_APP_VERSHINA_TYRES_URL=
REACT_APP_VERSHINA_DISCS_URL=
