{
  "name": "catalog-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Yandex Cloud Function: scheduled catalog sync → Object Storage",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/handler.js --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js",
    "test": "node --experimental-default-type=module --test src/*.test.js",
    "pack": "npm run build && node scripts/pack.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "fast-xml-parser": "^5.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
