{
  "name": "ivanor",
  "version": "0.1.0",
  "homepage": "https://iscander-b10.github.io/tyres_discs",
  "private": true,
  "dependencies": {
    "antd": "^5.27.4",
    "fast-xml-parser": "^5.3.0",
    "http-proxy-middleware": "^3.0.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.4",
    "react-scripts": "5.0.1",
    "sass": "1.78.0",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "prestart": "node scripts/generate-auth-verifier.js development",
    "start": "react-scripts start",
    "prebuild": "node scripts/generate-auth-verifier.js production",
    "build": "react-scripts build",
    "preview:prod": "node scripts/serve-prod-preview.js",
    "start:prod": "npm run build && node scripts/serve-prod-preview.js",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:gate": "node scripts/check-docs-sync.js",
    "docs:check": "npm run docs:gate && npm run docs:build",
    "docs:preview": "vitepress preview docs",
    "eject": "react-scripts eject",
    "predeploy": "npm run build && node -e \"require('fs').copyFileSync('build/index.html', 'build/404.html'); require('fs').writeFileSync('build/.nojekyll', '')\"",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "fake-indexeddb": "^4.0.2",
    "gh-pages": "^6.3.0",
    "mermaid": "^11.17.1",
    "vitepress": "^1.6.4",
    "vitepress-mermaid-plugin": "^3.0.0"
  }
}
